---
import Cite from "./Cite.astro";
import MapVisual from "./visuals/MapVisual.astro";
import MeaningVisual from "./visuals/MeaningVisual.astro";
import TokenVisual from "./visuals/TokenVisual.astro";
import LanesVisual from "./visuals/LanesVisual.astro";
import JudgeVisual from "./visuals/JudgeVisual.astro";

const steps = [
  { title: "A live map, derived from code", Visual: MapVisual },
  { title: "Meaning, not lines", Visual: MeaningVisual },
  { title: "Access is earned with proof", Visual: TokenVisual },
  { title: "Every change gets a lane", Visual: LanesVisual },
  { title: "A judge that verifies", Visual: JudgeVisual },
];
---

<section class="section how" id="how" aria-labelledby="how-title">
  <div class="wrap">
    <div class="head">
      <h2 class="display-l" id="how-title">How a change moves through Onus</h2>
      <p class="body-l muted">
        Agents propose. Machines check the facts. People see only what deserves their attention.
      </p>
    </div>

    <div class="scrolly" data-scrolly>
      <div class="stage" data-stage data-active="0" aria-hidden="true">
        {
          steps.map(({ Visual }, i) => (
            <div class="stage-item" data-item={i}>
              <Visual />
            </div>
          ))
        }
        <p class="stage-count label muted"><span data-stage-n>1</span> of {steps.length}</p>
      </div>

      <ol class="steps">
        <li class="step" data-step="0">
          <p class="step-n display-s" aria-hidden="true">1</p>
          <h3 class="display-s">{steps[0].title}</h3>
          <p class="body-l muted">
            Onus rebuilds a map of components, contracts, owners and risk labels on every change. Agents ask it
            questions instead of reading 50 files and guessing.
          </p>
          <div class="inline-visual"><MapVisual /></div>
        </li>
        <li class="step" data-step="1">
          <p class="step-n display-s" aria-hidden="true">2</p>
          <h3 class="display-s">{steps[1].title}</h3>
          <p class="body-l muted">
            Every change is described by what it does to the system. A rename across 40 files becomes one quiet
            row. A <code>&gt;</code> that became <code>&gt;=</code> in a payments check goes to the top.
          </p>
          <div class="inline-visual"><MeaningVisual /></div>
        </li>
        <li class="step" data-step="2">
          <p class="step-n display-s" aria-hidden="true">3</p>
          <h3 class="display-s">{steps[2].title}</h3>
          <p class="body-l muted">
            Each task runs with a short-lived token that opens only the doors it needs. To get more, an agent
            attaches evidence. A structured way to escalate cut test-gaming from 23.6% to 5.3% across eight
            frontier models.<Cite id="escalation" />
          </p>
          <div class="inline-visual"><TokenVisual /></div>
        </li>
        <li class="step" data-step="3">
          <p class="step-n display-s" aria-hidden="true">4</p>
          <h3 class="display-s">{steps[3].title}</h3>
          <p class="body-l muted">
            Rules set the floor, and a model can only move a change up. Auth, payments and personal data go to a
            person, and so does any change to tests, CI or policy.
          </p>
          <div class="inline-visual"><LanesVisual /></div>
        </li>
        <li class="step" data-step="4">
          <p class="step-n display-s" aria-hidden="true">5</p>
          <h3 class="display-s">{steps[4].title}</h3>
          <p class="body-l muted">
            It re-runs the evidence in a fresh environment and runs checks the author never saw. It never reads
            the author's reasoning, since models favor work that looks like their own.<Cite id="self-preference" />
          </p>
          <div class="inline-visual"><JudgeVisual /></div>
        </li>
      </ol>
    </div>
  </div>
</section>

<style>
  .head {
    display: grid;
    gap: var(--space-5);
    max-width: 52rem;
  }

  .head .body-l {
    max-width: 34rem;
  }

  .scrolly {
    margin-top: clamp(var(--space-8), 3rem + 4vw, var(--space-10));
  }

  .stage {
    display: none;
  }

  .steps {
    display: grid;
    gap: var(--space-9);
  }

  .step {
    display: grid;
    gap: var(--space-4);
    align-content: center;
  }

  .step-n {
    color: var(--ink-muted);
  }

  .step .body-l {
    max-width: 30rem;
  }

  .inline-visual {
    margin-top: var(--space-4);
    padding: var(--space-4);
    border-radius: var(--radius-l);
    background: var(--sunken);
  }

  @media (min-width: 64rem) {
    .scrolly {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: var(--space-9);
    }

    .stage {
      display: block;
      position: sticky;
      top: calc(50vh - 17rem);
      height: 34rem;
      padding: var(--space-6);
      border-radius: var(--radius-l);
      background: var(--sunken);
    }

    .stage-item {
      position: absolute;
      inset: var(--space-6) var(--space-6) var(--space-8);
      display: grid;
      opacity: 0;
      visibility: hidden;
      transform: translateY(18px) scale(0.985);
      transition:
        opacity 0.45s ease,
        transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1),
        visibility 0s linear 0.6s;
    }

    .stage[data-active="0"] [data-item="0"],
    .stage[data-active="1"] [data-item="1"],
    .stage[data-active="2"] [data-item="2"],
    .stage[data-active="3"] [data-item="3"],
    .stage[data-active="4"] [data-item="4"] {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition-delay: 0s;
    }

    .stage-count {
      position: absolute;
      left: var(--space-6);
      bottom: var(--space-5);
      font-variant-numeric: tabular-nums;
    }

    .steps {
      gap: 0;
    }

    .step {
      min-height: 72vh;
      transition: opacity 0.4s ease;
    }

    .scrolly.is-live .step:not(.is-active) {
      opacity: 0.32;
    }

    .inline-visual {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stage-item,
    .step {
      transition: none !important;
      transform: none !important;
    }
  }
</style>

<script>
  const scrolly = document.querySelector<HTMLElement>("[data-scrolly]");
  if (scrolly) {
    const stage = scrolly.querySelector<HTMLElement>("[data-stage]")!;
    const n = scrolly.querySelector<HTMLElement>("[data-stage-n]")!;
    const steps = Array.from(scrolly.querySelectorAll<HTMLElement>("[data-step]"));
    const activate = (i: number) => {
      stage.dataset.active = String(i);
      n.textContent = String(i + 1);
      steps.forEach((s, j) => s.classList.toggle("is-active", j === i));
    };
    activate(0);
    scrolly.classList.add("is-live");
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) activate(Number((e.target as HTMLElement).dataset.step));
        }
      },
      { rootMargin: "-45% 0px -45% 0px" },
    );
    steps.forEach((s) => io.observe(s));
  }
</script>
