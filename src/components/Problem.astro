---
import Cite from "./Cite.astro";

// Growth multiples after the "2x" push (He et al., July 2026). The scale runs from 0 to 3.5x.
const max = 3.5;
const bars = [
  { label: "Pull requests", value: 3.1, signal: false, tip: "Pull request volume grew 3.1 times" },
  { label: "Reviewers", value: 1.5, signal: true, tip: "The pool of reviewers grew 1.5 times" },
];
const pct = (v: number) => `${(v / max) * 100}%`;
---

<section class="band on-band section problem" aria-labelledby="problem-title">
  <div class="wrap">
    <h2 class="display-l" id="problem-title">Output scales. Attention doesn't.</h2>
  </div>
  <div class="wrap grid">
    <div class="copy">
      <p class="body-l muted">
        When one company set out to double merged pull requests per engineer, output did double. Review
        couldn't keep up. The share of pull requests with any human review fell from 89% to 68%, while
        review by AI bots rose from 19% to 84%.<Cite id="two-x" />
      </p>
    </div>

    <figure class="chart">
      <figcaption class="label muted">Growth after the push to double output</figcaption>
      <div class="o-bars plot">
        {
          bars.map((b) => (
            <div class="o-bar">
              <span class="o-bar__label">{b.label}</span>
              <div class="o-bar__track" tabindex="0" data-tip={b.tip} aria-label={`${b.tip}.`}>
                <div class:list={["o-bar__fill", b.signal && "o-bar__fill--signal"]} style={`width:${pct(b.value)}`} />
                <span class="o-bar__value" style={`left:${pct(b.value)}`}>{b.value}×</span>
              </div>
            </div>
          ))
        }
        <span class="baseline" style={`left:${pct(1)}`} aria-hidden="true"><span>Before, 1×</span></span>
      </div>
      <table class="visually-hidden">
        <caption>Growth multiples after the push to double output</caption>
        <tbody>
          {bars.map((b) => <tr><th scope="row">{b.label}</th><td>{b.value}×</td></tr>)}
        </tbody>
      </table>
    </figure>
  </div>

  <div class="wrap verdict-wrap">
    <p class="display-m verdict">Tired humans can't be the check. Green tests can't be the check.</p>
    <p class="muted measure">
      When people stop reading, agents learn to satisfy tests rather than intent. In one benchmark, an
      agent's “C compiler” turned out to be a 2,900-line lookup table of the expected outputs.<Cite id="specbench" />
    </p>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: var(--space-8);
    margin-top: clamp(var(--space-7), 2rem + 3vw, var(--space-8));
  }

  @media (min-width: 62rem) {
    .grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      align-items: start;
      gap: var(--space-9);
    }
  }

  .copy .body-l {
    max-width: 36rem;
  }

  .chart {
    display: grid;
    gap: var(--space-5);
  }

  .plot {
    position: relative;
    padding-bottom: var(--space-6);
  }

  .o-bar__track {
    border-radius: 0 var(--radius-xs) var(--radius-xs) 0;
    outline-offset: 4px;
  }

  .o-bar__track::after {
    content: attr(data-tip);
    position: absolute;
    left: 0;
    bottom: calc(100% + 8px);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-s);
    background: var(--on-band);
    color: var(--band);
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
    box-shadow: var(--shadow-pop);
    opacity: 0;
    transform: translateY(4px);
    pointer-events: none;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .o-bar__track:hover::after,
  .o-bar__track:focus-visible::after {
    opacity: 1;
    transform: none;
  }

  .baseline {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 0;
    border-left: 1px dashed var(--on-band-muted);
  }

  .baseline span {
    position: absolute;
    bottom: 0;
    left: var(--space-2);
    font-size: 0.8125rem;
    color: var(--on-band-muted);
    white-space: nowrap;
  }

  .verdict-wrap {
    margin-top: clamp(var(--space-9), 4rem + 6vw, var(--space-11));
    display: grid;
    gap: var(--space-5);
  }

  .verdict {
    max-width: 22ch;
  }
</style>
