---
// Dumbbell chart: share of pull requests before and after the "2x" push.
// Source: He et al., July 2026, as cited in the manifesto.
const rows = [
  { label: "Had any human review", before: 89, after: 68 },
  { label: "Were reviewed by an AI bot", before: 19, after: 84 },
  { label: "Got a human review with a written comment", before: 39, after: 21 },
];
const ticks = [0, 25, 50, 75, 100];
---

<figure class="chart" data-chart>
  <figcaption>
    <p class="chart-title">Share of pull requests, before and after the push to double output</p>
    <ul class="legend" role="list">
      <li><span class="key key-before" aria-hidden="true"></span>Before</li>
      <li><span class="key key-after" aria-hidden="true"></span>After</li>
    </ul>
  </figcaption>

  <div class="plot" role="group" aria-label="Dumbbell chart; the same values are in the table below">
    {
      rows.map((r) => {
        const lo = Math.min(r.before, r.after);
        const hi = Math.max(r.before, r.after);
        const beforeSide = r.before < r.after ? "left" : "right";
        const afterSide = beforeSide === "left" ? "right" : "left";
        return (
          <div class="row">
            <p class="row-label">{r.label}</p>
            <div class="track">
              {ticks.map((t) => (
                <span class="grid" style={`left:${t}%`} aria-hidden="true" />
              ))}
              <span class="bar" style={`left:${lo}%; width:${hi - lo}%`} aria-hidden="true" />
              <button
                type="button"
                class="pt pt-before"
                style={`left:${r.before}%`}
                data-tip-value={`${r.before}%`}
                data-tip-label={`${r.label}, before`}
                aria-label={`${r.label}, before: ${r.before}%`}
              >
                <span class="dot" />
              </button>
              <button
                type="button"
                class="pt pt-after"
                style={`left:${r.after}%`}
                data-tip-value={`${r.after}%`}
                data-tip-label={`${r.label}, after`}
                aria-label={`${r.label}, after: ${r.after}%`}
              >
                <span class="dot" />
              </button>
              <span class={`val val-before side-${beforeSide}`} style={`left:${r.before}%`} aria-hidden="true">
                {r.before}%
              </span>
              <span class={`val val-after side-${afterSide}`} style={`left:${r.after}%`} aria-hidden="true">
                {r.after}%
              </span>
            </div>
          </div>
        );
      })
    }
    <div class="row axis-row" aria-hidden="true">
      <span class="row-label"></span>
      <div class="axis">
        {ticks.map((t) => <span style={`left:${t}%`}>{t}%</span>)}
      </div>
    </div>
    <div class="tip" data-tip role="status" aria-live="polite" hidden>
      <strong data-tip-value></strong>
      <span data-tip-label></span>
    </div>
  </div>

  <details class="table-view">
    <summary>Show the numbers as a table</summary>
    <table>
      <thead>
        <tr><th scope="col">Pull requests that…</th><th scope="col">Before</th><th scope="col">After</th></tr>
      </thead>
      <tbody>
        {
          rows.map((r) => (
            <tr>
              <th scope="row">{r.label}</th>
              <td>{r.before}%</td>
              <td>{r.after}%</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </details>
  <p class="chart-source">
    Source: He et al., <a href="https://arxiv.org/abs/2607.01904">AI Writes Faster Than Humans Can Review</a>,
    a study of 802 developers, July 2026. Bot and comment figures are approximate.
  </p>
</figure>

<style>
  .chart {
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius-panel);
    padding: clamp(1.1rem, 0.7rem + 1.6vw, 2rem);
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    margin-bottom: 1.5rem;
  }

  .chart-title {
    font-weight: 650;
    font-size: 1.0625rem;
    line-height: 1.35;
    max-width: 40ch;
  }

  .legend {
    display: flex;
    gap: 1.1rem;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .legend li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .key {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
  }

  .key-before {
    background: var(--chart-before);
  }

  .key-after {
    background: var(--chart-after);
  }

  .plot {
    position: relative;
  }

  .row {
    display: grid;
    grid-template-columns: minmax(10rem, 15rem) 1fr;
    align-items: center;
    gap: 1.25rem;
    min-height: 3.5rem;
  }

  .row-label {
    font-size: 0.9375rem;
    line-height: 1.3;
  }

  .track {
    position: relative;
    height: 2.75rem;
    margin-inline: 0.75rem;
  }

  .grid {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--rule-paper);
  }

  .bar {
    position: absolute;
    top: 50%;
    height: 2px;
    margin-top: -1px;
    background: var(--chart-before);
    border-radius: 2px;
  }

  /* Hit target is 28px; the visible dot is 12px with a 2px surface ring. */
  .pt {
    position: absolute;
    top: 50%;
    width: 28px;
    height: 28px;
    margin: -14px 0 0 -14px;
    padding: 0;
    border: 0;
    background: transparent;
    border-radius: 50%;
    cursor: default;
    display: grid;
    place-items: center;
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    box-shadow: 0 0 0 2px var(--paper);
    transition: transform 0.15s ease;
  }

  .pt-before .dot {
    background: var(--chart-before);
  }

  .pt-after .dot {
    background: var(--chart-after);
  }

  .pt:hover .dot,
  .pt:focus-visible .dot {
    transform: scale(1.35);
  }

  .val {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    pointer-events: none;
  }

  .val-before {
    color: var(--ink-2);
  }

  .val-after {
    color: var(--ink);
    font-weight: 700;
  }

  .side-left {
    translate: calc(-100% - 14px) 0;
  }

  .side-right {
    translate: 14px 0;
  }

  .axis-row {
    min-height: 1.5rem;
  }

  .axis {
    position: relative;
    height: 1.25rem;
    margin-inline: 0.75rem;
    font-size: 0.8125rem;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  .axis span {
    position: absolute;
    transform: translateX(-50%);
  }

  .tip {
    position: absolute;
    z-index: 2;
    pointer-events: none;
    background: var(--ink);
    color: var(--paper);
    padding: 0.45rem 0.65rem;
    border-radius: 6px;
    font-size: 0.875rem;
    line-height: 1.3;
    display: grid;
    max-width: 16rem;
    transform: translate(-50%, calc(-100% - 12px));
  }

  .tip[hidden] {
    display: none;
  }

  .tip strong {
    font-size: 1rem;
  }

  .table-view {
    margin-top: 1.25rem;
    font-size: 0.9375rem;
  }

  summary {
    cursor: pointer;
    color: var(--cobalt);
    width: fit-content;
  }

  table {
    margin-top: 0.75rem;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  th,
  td {
    text-align: left;
    padding: 0.4rem 1.25rem 0.4rem 0;
    border-bottom: 1px solid var(--rule-paper);
  }

  thead th {
    font-weight: 600;
    color: var(--ink-2);
  }

  tbody th {
    font-weight: 400;
  }

  .chart-source {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--ink-2);
  }

  @media (max-width: 40rem) {
    .row {
      grid-template-columns: 1fr;
      gap: 0.25rem;
      padding-top: 0.75rem;
    }

    .axis-row .row-label {
      display: none;
    }
  }
</style>

<script>
  for (const chart of document.querySelectorAll<HTMLElement>("[data-chart]")) {
    const plot = chart.querySelector<HTMLElement>(".plot")!;
    const tip = chart.querySelector<HTMLElement>("[data-tip]")!;
    const tipValue = tip.querySelector<HTMLElement>("[data-tip-value]")!;
    const tipLabel = tip.querySelector<HTMLElement>("[data-tip-label]")!;

    const showTip = (pt: HTMLElement) => {
      tipValue.textContent = pt.dataset.tipValue ?? "";
      tipLabel.textContent = pt.dataset.tipLabel ?? "";
      const p = plot.getBoundingClientRect();
      const r = pt.getBoundingClientRect();
      tip.style.left = `${r.left + r.width / 2 - p.left}px`;
      tip.style.top = `${r.top - p.top}px`;
      tip.hidden = false;
    };
    const hideTip = () => {
      tip.hidden = true;
    };

    for (const pt of chart.querySelectorAll<HTMLElement>(".pt")) {
      pt.addEventListener("pointerenter", () => showTip(pt));
      pt.addEventListener("focus", () => showTip(pt));
      pt.addEventListener("pointerleave", hideTip);
      pt.addEventListener("blur", hideTip);
    }
  }
</script>
