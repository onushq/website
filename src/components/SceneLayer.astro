---
// The fixed 3D layer behind the page. Sections mark their place in the story with data-phase.
---

<div class="scene" aria-hidden="true">
  <canvas class="scene-canvas" data-scene-canvas></canvas>
  <div class="scene-shade"></div>
  <div class="scene-labels" data-scene-labels></div>
</div>

<style>
  .scene {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .scene-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .scene-canvas.is-ready {
    opacity: 1;
  }

  /* Keeps the text column legible over the scene. */
  .scene-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg,
        color-mix(in srgb, var(--canvas) 88%, transparent) 0%,
        color-mix(in srgb, var(--canvas) 62%, transparent) 30%,
        transparent 56%),
      linear-gradient(0deg, color-mix(in srgb, var(--canvas) 70%, transparent) 0%, transparent 22%),
      linear-gradient(180deg, color-mix(in srgb, var(--canvas) 75%, transparent) 0%, transparent 16%);
  }

  @media (max-width: 52rem) {
    .scene-shade {
      background: color-mix(in srgb, var(--canvas) 58%, transparent);
    }
  }

  .scene-labels {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  /* On narrow screens the scene is a backdrop behind the text; its labels would collide with it. */
  @media (max-width: 52rem) {
    .scene-labels {
      display: none;
    }
  }

  .scene-labels :global(.scene-label) {
    position: absolute;
    left: 0;
    top: 0;
    translate: -50% -100%;
    opacity: 0;
    padding: 3px 9px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--surface) 78%, transparent);
    color: var(--ink);
    font-size: 0.8125rem;
    font-stretch: 82%;
    font-weight: 600;
    line-height: 1.3;
    white-space: nowrap;
    will-change: transform, opacity;
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .scene-labels :global(.scene-label.is-left) {
    translate: 0 -100%;
  }

  .scene-labels :global(.scene-label.is-right) {
    translate: -100% -100%;
  }

  .scene-labels :global(.scene-label.is-signal) {
    background: var(--signal);
    color: var(--on-signal);
  }

  :global(html.no-webgl) .scene-canvas {
    display: none;
  }
</style>

<script>
  import Lenis from "lenis";
  import type { OnusScene } from "../scene/engine";

  const canvas = document.querySelector<HTMLCanvasElement>("[data-scene-canvas]")!;
  const labelLayer = document.querySelector<HTMLElement>("[data-scene-labels]")!;
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const coarse = window.matchMedia("(pointer: coarse)").matches;
  const cores = navigator.hardwareConcurrency ?? 8;
  const forced = new URLSearchParams(location.search).get("quality");
  const quality = forced === "low" || forced === "high" ? forced : coarse || window.innerWidth < 820 || cores <= 4 ? "low" : "high";

  const css = getComputedStyle(document.documentElement);
  const token = (name: string) => css.getPropertyValue(name).trim();

  let scene: OnusScene | null = null;

  // Scroll position -> story phase. Each chapter holds its formation while its text is
  // centered and morphs to the next one in between.
  const chapters = Array.from(document.querySelectorAll<HTMLElement>("[data-phase]"));
  let anchors: { phase: number; y: number }[] = [];
  const measure = () => {
    anchors = chapters.map((el) => {
      const rect = el.getBoundingClientRect();
      return {
        phase: Number(el.dataset.phase),
        y: rect.top + window.scrollY + rect.height / 2 - window.innerHeight / 2,
      };
    });
  };
  const smooth = (e0: number, e1: number, x: number) => {
    const t = Math.min(1, Math.max(0, (x - e0) / (e1 - e0)));
    return t * t * (3 - 2 * t);
  };
  const phaseAt = (y: number) => {
    if (!anchors.length) return 0;
    if (y <= anchors[0].y) return anchors[0].phase;
    for (let i = 0; i < anchors.length - 1; i++) {
      const a = anchors[i];
      const b = anchors[i + 1];
      if (y < b.y) return a.phase + (b.phase - a.phase) * smooth(0.18, 0.82, (y - a.y) / (b.y - a.y));
    }
    return anchors[anchors.length - 1].phase;
  };

  // Chapter rail.
  const railLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-rail] a"));
  const railTargets = railLinks.map((a) => document.querySelector<HTMLElement>(a.hash));
  let activeRail = -1;
  const updateRail = () => {
    const mid = window.innerHeight * 0.5;
    let idx = 0;
    railTargets.forEach((el, i) => {
      if (el && el.getBoundingClientRect().top <= mid) idx = i;
    });
    if (idx !== activeRail) {
      railLinks.forEach((a, i) => a.toggleAttribute("aria-current", i === idx));
      activeRail = idx;
    }
  };

  const lenis = reducedMotion || coarse ? null : new Lenis({ autoRaf: false, lerp: 0.11, anchors: true });

  measure();
  updateRail();
  window.addEventListener("resize", () => {
    measure();
    scene?.resize();
  });
  window.addEventListener("load", measure);
  window.addEventListener(
    "pointermove",
    (e) => scene?.setPointer((e.clientX / window.innerWidth) * 2 - 1, -((e.clientY / window.innerHeight) * 2 - 1)),
    { passive: true },
  );

  const tick = () => {
    lenis?.raf(performance.now());
    scene?.setPhaseTarget(phaseAt(window.scrollY));
    updateRail();
  };

  // Paint the page first, then load the 3D layer as its own chunk.
  let fallback = 0;
  const loop = () => {
    tick();
    fallback = requestAnimationFrame(loop);
  };
  fallback = requestAnimationFrame(loop);

  import("../scene/engine")
    .then(({ OnusScene }) => {
      scene = new OnusScene({
        canvas,
        labelLayer,
        quality,
        reducedMotion,
        colors: {
          bg: token("--canvas"),
          ink: token("--ink-muted"),
          signal: token("--signal"),
          red: token("--del"),
          green: token("--add"),
        },
      });
      cancelAnimationFrame(fallback);
      scene.onTick(tick);
      scene.start();
      requestAnimationFrame(() => requestAnimationFrame(() => canvas.classList.add("is-ready")));
    })
    .catch(() => document.documentElement.classList.add("no-webgl"));
</script>
