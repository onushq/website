---
---

<header class="site-header" data-header>
  <div class="wrap bar">
    <a class="wordmark" href="/" aria-label="Onus home">Onus</a>
    <nav aria-label="Primary">
      <ul>
        <li class="hide-sm"><a href="#meaning">How it works</a></li>
        <li class="hide-sm"><a href="#roadmap">Roadmap</a></li>
        <li class="hide-sm"><a href="#install">Install</a></li>
        <li><a href="/docs">Docs</a></li>
        <li><a class="o-button o-button--quiet gh" href="https://github.com/onushq">GitHub</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 20;
    border-bottom: 1px solid transparent;
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .site-header.is-scrolled {
    background: color-mix(in srgb, var(--canvas) 70%, transparent);
    -webkit-backdrop-filter: saturate(1.3) blur(16px);
    backdrop-filter: saturate(1.3) blur(16px);
    border-bottom-color: color-mix(in srgb, var(--ink) 8%, transparent);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    height: 72px;
  }

  .wordmark {
    font-size: 1.5rem;
    font-stretch: 125%;
    font-weight: 750;
    letter-spacing: -0.035em;
    text-decoration: none;
  }

  ul {
    display: flex;
    align-items: center;
    gap: clamp(var(--space-4), 2.5vw, var(--space-6));
  }

  nav a:not(.o-button) {
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--ink-muted);
    transition: color 0.2s ease;
  }

  nav a:not(.o-button):hover {
    color: var(--ink);
  }

  .gh {
    min-height: 38px;
    padding: 0 var(--space-4);
  }

  @media (max-width: 34rem) {
    .hide-sm {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  if (header) {
    const update = () => header.classList.toggle("is-scrolled", window.scrollY > 8);
    update();
    window.addEventListener("scroll", update, { passive: true });
  }
</script>
