---
const phases = [
  {
    name: "Semantic change reports",
    alone: "A bot posts a meaning-level summary on every pull request. Big agent PRs become reviewable.",
    gate: "Reviewers prefer the report to the raw diff on large pull requests.",
    now: true,
  },
  {
    name: "The map as a service",
    alone: "Agents and people query the map through MCP and a CLI. Agents stop guessing.",
    gate: "Map answers match reality on a sampled set of questions.",
  },
  {
    name: "Scoped tokens and escalation",
    alone: "Per-task tokens enforced at the doors. A hijacked agent reaches only what its task needed.",
    gate: "Escalations don't stall work, and no writes land out of scope.",
  },
  {
    name: "Risk lanes and the judge",
    alone: "Rules-first routing; the judge re-runs the evidence. Attention concentrates on the risky slice.",
    gate: "Audits of auto-approved changes find a low miss rate.",
  },
  {
    name: "Evidence factory and production loop",
    alone: "Disposable environments by default; outcomes retrain the classifier. It improves with use.",
  },
];
---

<section class="section roadmap" id="roadmap" aria-labelledby="roadmap-title">
  <div class="wrap">
    <div class="head">
      <h2 class="display-l" id="roadmap-title">Where we're starting.</h2>
      <p class="body-l muted">
        Five phases. Each one is useful on its own, and each moves on only when a measurable gate is passed.
      </p>
    </div>
    <ol class="phases">
      {
        phases.map((p, i) => (
          <li class:list={["phase", p.now && "is-now"]}>
            <div class="phase-top">
              <p class="label">Phase {i + 1}</p>
              {p.now && <span class="o-pill o-pill--outline now">Designing now</span>}
            </div>
            <h3 class="title">{p.name}</h3>
            <p class="phase-alone">{p.alone}</p>
            {p.gate && (
              <p class="gate caption">
                <span class="diamond" aria-hidden="true" />
                <span>
                  <span class="visually-hidden">Gate to the next phase: </span>
                  {p.gate}
                </span>
              </p>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .head {
    display: grid;
    gap: var(--space-5);
  }

  .head .body-l {
    max-width: 34rem;
  }

  .phases {
    margin-top: clamp(var(--space-8), 3rem + 3vw, var(--space-9));
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 64rem) {
    .phases {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  .phase {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: var(--space-3);
    padding: var(--space-5);
    border-radius: var(--radius-m);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .phase.is-now {
    background: var(--ink);
    color: var(--canvas);
    box-shadow: none;
  }

  .phase-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: 26px;
  }

  .phase-top .label {
    color: var(--ink-muted);
  }

  .is-now .phase-top .label {
    color: var(--canvas);
    opacity: 0.75;
  }

  .is-now .now {
    color: var(--canvas);
    box-shadow: inset 0 0 0 1px var(--canvas);
  }

  .phase-alone {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .is-now .phase-alone {
    color: var(--canvas);
    opacity: 0.8;
  }

  .gate {
    display: flex;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
    color: var(--ink-muted);
  }

  .is-now .gate {
    border-top-color: color-mix(in srgb, var(--canvas) 22%, transparent);
    color: var(--canvas);
    opacity: 0.8;
  }

  .diamond {
    flex: none;
    width: 8px;
    height: 8px;
    margin-top: 0.4em;
    border: 1.5px solid currentColor;
    transform: rotate(45deg);
  }
</style>
