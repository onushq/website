---
const phases = [
  {
    name: "Semantic change reports on today's pull requests",
    body: "A bot posts a meaning-level summary on every pull request. No new workflow needed.",
    alone: "Big agent pull requests become reviewable, and the first version of the map gets built.",
    gate: "Reviewers prefer the report to the raw diff on large pull requests.",
    now: true,
  },
  {
    name: "The map as a service",
    body: "Agents and people query components, contracts, owners and test coverage through MCP and a CLI.",
    alone: "Agents stop guessing about structure, and context costs drop.",
    gate: "Map answers match reality on a sampled set of questions.",
  },
  {
    name: "Scoped tokens and evidence-based escalation",
    body: "Per-task, path-level tokens enforced at a git gateway and MCP servers; structured escalation.",
    alone: "A hijacked agent can only reach what its task needed.",
    gate: "Escalations are rare enough not to stall work, and no writes land out of scope.",
  },
  {
    name: "Risk lanes and the verifying judge",
    body: "Rules-first routing into auto-merge, judge and human lanes; the judge re-runs the evidence.",
    alone: "Human attention concentrates on the risky slice.",
    gate: "Audits of auto-approved changes find an acceptably low miss rate.",
  },
  {
    name: "Evidence factory, production loop, contract-level scopes",
    body: "Disposable environments by default; outcomes retrain the classifier; scopes move from paths to contracts.",
    alone: "The system gets safer and faster the longer it runs.",
  },
];
---

<section class="section wrap roadmap" id="roadmap" aria-labelledby="roadmap-title">
  <h2 class="section-title" id="roadmap-title">Where we're starting.</h2>
  <p class="prose lead">
    Each phase ships something useful on its own, and each gate is a measurable reason to start the next
    one. Scoped permissions come before automated approval, because auto-merging without tight scopes is
    dangerous.
  </p>

  <ol class="phases">
    {
      phases.map((p, i) => (
        <li class={`phase ${p.now ? "is-now" : ""}`}>
          <div class="phase-card">
            <p class="phase-n">
              Phase {i + 1}
              {p.now && <span class="now">Designing now</span>}
            </p>
            <h3 class="phase-name">{p.name}</h3>
            <p class="phase-body">{p.body}</p>
            <p class="phase-alone">
              <span>Useful alone:</span> {p.alone}
            </p>
          </div>
          {p.gate && (
            <p class="gate">
              <span class="diamond" aria-hidden="true" />
              <span>
                <span class="visually-hidden">Gate to the next phase: </span>
                {p.gate}
              </span>
            </p>
          )}
        </li>
      ))
    }
  </ol>
</section>

<style>
  .lead {
    margin-top: 1.5rem;
  }

  .phases {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    max-width: 52rem;
  }

  .phase-card {
    background: var(--paper);
    border: 1px solid var(--rule-paper);
    border-left: 8px solid var(--rule);
    border-radius: var(--radius-strip);
    padding: 1rem 1.25rem 1.1rem;
  }

  .is-now .phase-card {
    border-left-color: var(--cobalt);
    box-shadow: inset 0 0 0 1px var(--cobalt);
  }

  .phase-n {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    font-size: 0.9375rem;
    font-weight: 650;
    color: var(--ink-2);
  }

  .now {
    color: var(--cobalt);
  }

  .phase-name {
    margin-top: 0.2rem;
    font-size: 1.25rem;
    font-stretch: 112%;
    font-weight: 720;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .phase-body {
    margin-top: 0.4rem;
    font-size: 0.9875rem;
    line-height: 1.5;
  }

  .phase-alone {
    margin-top: 0.4rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .phase-alone span {
    font-weight: 600;
  }

  .gate {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-left: 1.6rem;
    padding: 1.1rem 0 1.1rem 0;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .gate::before {
    content: "";
    position: absolute;
    left: 6px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--ink-2);
  }

  .diamond {
    position: relative;
    flex: none;
    width: 13px;
    height: 13px;
    background: var(--board);
    border: 1.5px solid var(--ink-2);
    transform: rotate(45deg);
  }
</style>
