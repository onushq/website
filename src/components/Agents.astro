---
const asks = [
  { name: "Speak MCP or run a CLI", body: "Any agent that can run a shell command can use Onus. Agents that support MCP get the same tools natively." },
  { name: "Work inside its token", body: "And ask for more through escalation, with evidence attached." },
  { name: "Submit evidence with every change", body: "The stated intent, the semantic report, and the tests and traces behind it." },
];
---

<section class="section agents" aria-labelledby="agents-title">
  <div class="wrap">
    <div class="top">
      <h2 class="display-l" id="agents-title">Any agent. Same rules.</h2>
      <p class="body-l muted">
        Onus isn't an agent and doesn't pick one for you. Codex, Claude Code or one you built yourself: each
        gets the same scopes, lanes and review, and earns its own track record.
      </p>
    </div>
    <ul class="asks">
      {
        asks.map((a) => (
          <li>
            <h3 class="title">{a.name}</h3>
            <p class="muted">{a.body}</p>
          </li>
        ))
      }
    </ul>
    <p class="swap display-s">
      Swap every agent overnight and nothing in Onus changes. Only the track records start fresh.
    </p>
  </div>
</section>

<style>
  .top {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 62rem) {
    .top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: end;
      gap: var(--space-9);
    }
  }

  .top .body-l {
    max-width: 32rem;
  }

  .asks {
    margin-top: clamp(var(--space-8), 3rem + 3vw, var(--space-9));
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-6);
  }

  .asks li {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding-top: var(--space-5);
    border-top: 2px solid var(--ink);
  }

  .swap {
    margin-top: clamp(var(--space-8), 3rem + 3vw, var(--space-9));
    max-width: 30ch;
  }
</style>
