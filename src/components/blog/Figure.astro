---
// A diagram in a blog post: a mono label, a title, the drawing, and a caption.
// Figures break out of the reading column to the width of .post-wide.
interface Props {
  label: string;
  title: string;
  caption: string;
}

const { label, title, caption } = Astro.props;
---

<figure class="post-figure">
  <p class="fig-label code">{label}</p>
  <p class="fig-title">{title}</p>
  <div class="fig-body">
    <slot />
  </div>
  <figcaption class="fig-caption">{caption}</figcaption>
</figure>

<style>
  .post-figure {
    --conn: var(--ink-faint);
    margin-block: var(--space-7);
    padding: clamp(var(--space-4), 3vw, var(--space-6));
    background: var(--sunken);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
  }

  .fig-label {
    font-size: 0.75rem;
    color: var(--ink-faint);
    letter-spacing: 0.02em;
  }

  .fig-title {
    margin-top: var(--space-2);
    font-size: 1.125rem;
    font-stretch: 112%;
    font-weight: 620;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .fig-body {
    margin-top: var(--space-5);
  }

  .fig-caption {
    margin-top: var(--space-5);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink-muted);
    max-width: 40rem;
  }
</style>
