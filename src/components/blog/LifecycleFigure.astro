---
// One change from intent to production, with the two loops that keep ACP honest.
// Wide screens draw the loops as connectors; narrow ones write them into the steps.
import Figure from "./Figure.astro";

const lanes = [
  { name: "Auto-merge", note: "low risk" },
  { name: "Judge verifies", note: "medium risk" },
  { name: "Human reviews", note: "high risk", person: true },
];
---

<Figure
  label="change lifecycle · 9 steps, 3 review lanes, 2 loops"
  title="A change moves to production on evidence, not on line-reading"
  caption="Blocked changes stop at the classifier and aren't drawn. Two loops keep the system honest: escalation when an agent is stuck, and production outcomes that retrain the classifier."
>
  <div class="flow">
    <div class="step" style="grid-row: 1">
      <div class="box"><strong>Intent</strong><span>a person states the goal</span></div>
    </div>
    <div class="step" style="grid-row: 2">
      <div class="box"><strong>Plan with the map</strong><span>agent asks what is affected</span></div>
    </div>
    <div class="step" style="grid-row: 3">
      <div class="box"><strong>Scoped token minted</strong><span>short-lived, least privilege</span></div>
    </div>
    <div class="grant wide-only" style="grid-row: 3" aria-hidden="true"><span>narrow grant</span></div>
    <div class="step" style="grid-row: 4">
      <div class="box">
        <strong>Build and test</strong><span>in a disposable sandbox</span>
        <span class="loop narrow-only">If blocked: escalate with evidence (failing test, trace, map path) for a narrow grant</span>
      </div>
    </div>
    <div class="box escalate wide-only" style="grid-row: 4">
      <span class="blocked" aria-hidden="true">blocked</span>
      <strong>Escalate with evidence</strong><span>failing test, trace, map path</span>
    </div>
    <div class="step" style="grid-row: 5">
      <div class="box"><strong>Submit application</strong><span>intent, report, evidence</span></div>
    </div>
    <div class="step split" style="grid-row: 6">
      <div class="box key"><strong>Risk classifier</strong><span>picks the review lane</span></div>
    </div>
    <ul class="lanes" style="grid-row: 7">
      {
        lanes.map((l) => (
          <li class:list={["box", { person: l.person }]}>
            <strong>{l.name}</strong>
            <span>{l.note}</span>
          </li>
        ))
      }
    </ul>
    <div class="step" style="grid-row: 8">
      <div class="box"><strong>Merge and staged rollout</strong><span>flags, canaries, automatic rollback</span></div>
    </div>
    <div class="step last" style="grid-row: 9">
      <div class="box">
        <strong>Production signals</strong><span>errors, incidents, reverts</span>
        <span class="loop narrow-only">Outcomes retrain the risk classifier</span>
      </div>
    </div>
    <div class="retrain wide-only" style="grid-row: 6 / 10" aria-hidden="true">
      <span>outcomes retrain the classifier</span>
    </div>
  </div>
</Figure>

<style>
  .flow {
    --a: var(--space-5);
    --drop: var(--space-4);
    --lane-gap: var(--space-3);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    max-width: 30rem;
    margin-inline: auto;
  }

  .box {
    position: relative;
    display: grid;
    align-content: center;
    gap: 1px;
    padding: var(--space-3) var(--space-4);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-s);
    text-align: center;
    font-size: 0.9375rem;
    line-height: 1.3;
  }

  .box strong {
    font-weight: 620;
  }

  .box > span {
    color: var(--ink-muted);
    font-size: 0.8125rem;
  }

  .box > .loop {
    margin-top: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px dashed var(--line);
    color: var(--ink-faint);
    font-size: 0.75rem;
  }

  .key {
    border: 1.5px solid var(--ink-muted);
  }

  /* Amber means a person needs to look: the human lane is the only amber here. */
  .person {
    background: var(--signal-soft);
    border-color: var(--signal);
  }

  .person > span {
    color: var(--signal-ink);
  }

  /* Down arrows between steps. */
  .step {
    position: relative;
    padding-bottom: var(--a);
  }

  .step.last {
    padding-bottom: 0;
  }

  .step:not(.last)::after,
  .lanes .box::after {
    content: "";
    position: absolute;
    left: calc(50% - 4px);
    bottom: 0;
    height: var(--a);
    width: 8px;
    background:
      linear-gradient(var(--conn), var(--conn)) center top / 1px calc(100% - 6px) no-repeat,
      conic-gradient(from -30deg at 50% 100%, var(--conn) 60deg, transparent 0) center bottom / 8px 6px no-repeat;
  }

  /* The classifier splits into three lanes: a bar above them, a drop into each. */
  .split::after {
    background: linear-gradient(var(--conn), var(--conn)) center top / 1px 100% no-repeat;
  }

  .lanes {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--lane-gap);
    padding-top: var(--drop);
    padding-bottom: var(--a);
  }

  .lanes::before {
    content: "";
    position: absolute;
    top: 0;
    left: calc((100% - 2 * var(--lane-gap)) / 6);
    right: calc((100% - 2 * var(--lane-gap)) / 6);
    height: 1px;
    background: var(--conn);
  }

  .lanes .box {
    padding-inline: var(--space-2);
    font-size: 0.875rem;
  }

  .lanes .box::before {
    content: "";
    position: absolute;
    left: calc(50% - 4px);
    bottom: 100%;
    height: var(--drop);
    width: 8px;
    background:
      linear-gradient(var(--conn), var(--conn)) center top / 1px calc(100% - 6px) no-repeat,
      conic-gradient(from -30deg at 50% 100%, var(--conn) 60deg, transparent 0) center bottom / 8px 6px no-repeat;
  }

  .lanes .box::after {
    bottom: calc(-1 * var(--a));
  }

  .wide-only {
    display: none;
  }

  /* Wide: the escalation branch sits beside "Build and test", and the outcome loop runs up the right edge. */
  @media (min-width: 60rem) {
    .flow {
      --h: 4.25rem;
      --gx: 4.5rem;
      max-width: none;
      grid-template-columns: minmax(0, 26rem) minmax(0, 18rem) 3rem;
      justify-content: center;
    }

    .narrow-only {
      display: none;
    }

    .wide-only {
      display: block;
    }

    .step .box,
    .lanes .box,
    .escalate {
      height: var(--h);
    }

    .escalate {
      display: grid;
      grid-column: 2;
      align-self: start;
      margin-left: var(--gx);
    }

    /* "blocked": Build and test → Escalate. */
    .escalate::before {
      content: "";
      position: absolute;
      right: 100%;
      top: calc(50% - 4px);
      width: var(--gx);
      height: 8px;
      background:
        linear-gradient(var(--conn), var(--conn)) left center / calc(100% - 6px) 1px no-repeat,
        conic-gradient(from 240deg at 100% 50%, var(--conn) 60deg, transparent 0) right center / 6px 8px no-repeat;
    }

    .blocked {
      position: absolute;
      right: 100%;
      bottom: 50%;
      width: var(--gx);
      padding-bottom: var(--space-1);
      font-size: 0.75rem;
      color: var(--ink-muted);
    }

    /* "narrow grant": Escalate → back up to the token. */
    .grant {
      position: relative;
      grid-column: 2;
      margin-top: calc(var(--h) / 2);
      width: calc(var(--gx) + (100% - var(--gx)) / 2);
      border-top: 1px solid var(--conn);
      border-right: 1px solid var(--conn);
    }

    .grant::before,
    .retrain::before {
      content: "";
      position: absolute;
      left: 0;
      top: -4.5px;
      border-block: 4px solid transparent;
      border-right: 6px solid var(--conn);
    }

    .grant span {
      position: absolute;
      left: calc(100% + var(--space-3));
      top: 50%;
      transform: translateY(-50%);
      font-size: 0.75rem;
      color: var(--ink-muted);
      white-space: nowrap;
    }

    /* "outcomes retrain the classifier": Production → back up to the classifier. */
    .retrain {
      position: relative;
      grid-column: 2 / 4;
      margin-block: calc(var(--h) / 2);
      border: 1px solid var(--conn);
      border-left: 0;
      border-radius: 0 var(--radius-s) var(--radius-s) 0;
    }

    .retrain span {
      position: absolute;
      right: var(--space-5);
      bottom: var(--space-1);
      font-size: 0.75rem;
      color: var(--ink-muted);
    }
  }
</style>
