---
const phases = [
  { name: "Semantic change reports", alone: "A meaning-level summary on every pull request. Big agent PRs become reviewable.", gate: "Reviewers prefer the report to the raw diff." },
  { name: "The map as a service", alone: "Agents and people query the map through MCP and a CLI.", gate: "Map answers match reality on sampled questions." },
  { name: "Scoped tokens and escalation", alone: "A hijacked agent reaches only what its task needed.", gate: "No writes land out of scope." },
  { name: "Risk lanes and the judge", alone: "Human attention concentrates on the risky slice.", gate: "Audits find a low miss rate." },
  { name: "Evidence factory and production loop", alone: "Environments record evidence; outcomes feed back into the lanes. It improves with use." },
];
---

<section class="chapter roadmap" id="roadmap" data-phase="6" aria-labelledby="roadmap-title">
  <div class="wrap">
    <div class="chapter-copy">
      <h2 class="display-l" id="roadmap-title">Where we are.</h2>
      <p class="body-l">Five phases, all built. Each is useful on its own; the gates are now measured in the field, on real pull requests.</p>
    </div>
    <ol class="phases">
      {
        phases.map((p, i) => (
          <li class:list={["phase", "glass", p.now && "is-now"]}>
            <div class="phase-top">
              <p class="label">Phase {i + 1}</p>
              <a class="o-pill o-pill--outline now" href="#install">Available</a>
            </div>
            <h3 class="title">{p.name}</h3>
            <p class="alone">{p.alone}</p>
            {p.gate && (
              <p class="gate caption">
                <span class="diamond" aria-hidden="true" />
                <span>
                  <span class="visually-hidden">Gate to the next phase: </span>
                  {p.gate}
                </span>
              </p>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .roadmap > .wrap {
    display: grid;
    gap: clamp(var(--space-7), 2rem + 3vw, var(--space-9));
  }

  .phases {
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 64rem) {
    .phases {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  .phase {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: var(--space-3);
    padding: var(--space-5);
  }

  .phase.is-now {
    background: var(--ink);
    color: var(--canvas);
    border-color: transparent;
  }

  .phase-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: 26px;
  }

  .phase-top .label {
    color: var(--ink-muted);
  }

  .is-now .phase-top .label,
  .is-now .alone,
  .is-now .gate {
    color: var(--canvas);
    opacity: 0.78;
  }

  .is-now .now {
    text-decoration: none;
    color: var(--canvas);
    box-shadow: inset 0 0 0 1px var(--canvas);
  }

  .title {
    font-size: 1.125rem;
  }

  .alone {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .gate {
    display: flex;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid color-mix(in srgb, currentColor 18%, transparent);
    color: var(--ink-muted);
  }

  .diamond {
    flex: none;
    width: 8px;
    height: 8px;
    margin-top: 0.4em;
    border: 1.5px solid currentColor;
    transform: rotate(45deg);
  }
</style>
