---
import { changes, files, prTitle, totals } from "../data/pr";

const fmt = new Intl.NumberFormat("en-US");
const changed = totals.add + totals.del;
const minimapData = JSON.stringify(files.map((f) => [f.add, f.del, f.meaning]));
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap">
    <h1 class="display-xl" id="hero-title">
      <span>Code is not</span>
      <span>the product.</span>
    </h1>
    <div class="hero-foot">
      <p class="body-l lede">
        Agents now write code faster than anyone can read it. Onus is the layer every coding agent works
        through. It reads each change for what it means, routes it by risk, and approves it on evidence.
      </p>
      <div class="ctas">
        <a class="o-button o-button--primary" href="#how">See how it works</a>
        <a class="o-button o-button--quiet" href="https://github.com/onushq">Follow on GitHub</a>
      </div>
    </div>
  </div>

  <div class="wrap stage">
    <figure class="o-window report" data-report>
      <div class="o-window__bar">
        <div>
          <p class="o-window__title">{prTitle}</p>
          <p class="o-window__meta">Pull request opened by a coding agent</p>
        </div>
        <p class="o-window__meta">
          <span class="o-diffstat__add">+{fmt.format(totals.add)}</span>{" "}
          <span class="o-diffstat__del">−{fmt.format(totals.del)}</span> in {totals.files} files
        </p>
      </div>

      <div class="report-body">
        <div class="lines">
          <p class="label lines-count">
            <span data-count>{fmt.format(changed)}</span> changed lines
          </p>
          <div class="minimap-box">
            <canvas data-minimap aria-hidden="true"></canvas>
          </div>
          <p class="caption muted key">
            <span class="swatch swatch-add" aria-hidden="true"></span>Added
            <span class="swatch swatch-del" aria-hidden="true"></span>Removed
          </p>
        </div>

        <div class="meaning">
          <div class="meaning-head">
            <p class="label">4 changes in meaning</p>
            <span class="o-pill o-pill--signal"><span class="o-pill__dot" aria-hidden="true"></span>1 needs a person</span>
          </div>
          <ul class="rows">
            {
              changes.map((c, i) => (
                <li style={`--i:${i}`}>
                  <button
                    type="button"
                    class:list={[
                      "o-row",
                      c.person && "o-row--signal",
                      c.id === "contract" && "o-row--contract",
                      c.id === "event" && "o-row--edge",
                    ]}
                    data-meaning={c.id}
                    aria-pressed="false"
                  >
                    <span class="o-row__change">{c.change}</span>
                    <span class="o-row__meta">
                      <span class="o-row__kind">{c.kind}</span>
                      <span>{c.why}</span>
                    </span>
                  </button>
                </li>
              ))
            }
          </ul>
          <p class="route caption muted">
            Routed to a person: a new outside vendor will receive customers' phone numbers.
          </p>
        </div>
      </div>
    </figure>
    <p class="caption muted hint">
      Point at a change to see the lines behind it. An illustrative report for the manifesto's example
      feature.
    </p>
  </div>
  <script is:inline type="application/json" data-pr-files set:html={minimapData} />
</section>

<style>
  .hero {
    padding-top: clamp(var(--space-8), 3rem + 7vw, var(--space-11));
  }

  h1 span {
    display: block;
  }

  .hero-foot {
    margin-top: clamp(var(--space-6), 1rem + 3vw, var(--space-8));
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6) var(--space-8);
  }

  .lede {
    max-width: 36rem;
    color: var(--ink-muted);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .stage {
    margin-top: clamp(var(--space-8), 2rem + 6vw, var(--space-10));
  }

  .report-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 60rem) {
    .report-body {
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    }

    .lines {
      border-right: 1px solid var(--line);
    }
  }

  .lines,
  .meaning {
    padding: clamp(var(--space-5), 1rem + 1.5vw, var(--space-7));
    min-width: 0;
  }

  .lines {
    display: grid;
    align-content: start;
    gap: var(--space-4);
  }

  .lines-count {
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }

  .minimap-box {
    background: var(--sunken);
    border-radius: var(--radius-s);
    padding: var(--space-4);
  }

  canvas {
    width: 100%;
  }

  .key {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .swatch {
    width: 10px;
    height: 10px;
    border-radius: 2px;
  }

  .swatch-add {
    background: var(--add);
  }

  .swatch-del {
    background: var(--del);
    margin-left: var(--space-3);
  }

  .meaning-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .meaning-head .label {
    color: var(--ink-muted);
  }

  .rows {
    display: grid;
    gap: var(--space-2);
  }

  .o-row {
    cursor: pointer;
  }

  .o-row:hover,
  .o-row[aria-pressed="true"] {
    border-color: var(--control-border);
  }

  .o-row--signal:hover,
  .o-row--signal[aria-pressed="true"] {
    border-color: var(--signal);
  }

  .route {
    margin-top: var(--space-4);
  }

  .hint {
    margin-top: var(--space-4);
  }

  /* The one orchestrated moment: the lines pour in, then the meaning arrives. */
  :global(html.motion) .rows li {
    animation: row-in 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(1.05s + var(--i) * 0.09s);
  }

  :global(html.motion) .meaning-head,
  :global(html.motion) .route {
    animation: row-in 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: 0.95s;
  }

  @keyframes row-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
</style>

<script>
  type Meaning = "vendor" | "contract" | "event" | "internal";
  interface Line {
    m: Meaning;
    add: boolean;
    len: number;
    ind: number;
  }

  const report = document.querySelector<HTMLElement>("[data-report]");
  const dataEl = document.querySelector<HTMLScriptElement>("[data-pr-files]");
  if (report && dataEl) setUp(report, JSON.parse(dataEl.textContent ?? "[]"));

  function setUp(report: HTMLElement, data: [number, number, Meaning][]) {
    const canvas = report.querySelector<HTMLCanvasElement>("[data-minimap]")!;
    const count = report.querySelector<HTMLElement>("[data-count]")!;
    const ctx = canvas.getContext("2d")!;
    const buttons = Array.from(report.querySelectorAll<HTMLButtonElement>("[data-meaning]"));

    // Deterministic "code-shaped" lines: indentation drifts, lengths vary.
    let seed = 20260928;
    const rand = () => {
      seed |= 0;
      seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
    const lines: (Line | null)[] = [];
    data.forEach(([add, del, m], fileIndex) => {
      if (fileIndex > 0) lines.push(null, null, null);
      let ind = 0;
      for (let i = 0; i < add + del; i++) {
        const r = rand();
        if (r < 0.2 && ind < 4) ind++;
        else if (r < 0.4 && ind > 0) ind--;
        const len = rand() < 0.08 ? 0.12 : 0.28 + rand() * 0.68;
        lines.push({ m, add: i >= del, len, ind });
      }
    });
    const totalChanged = lines.filter(Boolean).length;

    let highlight: Meaning | null = null;
    let pinned: Meaning | null = null;
    let revealed = 1;
    let geometry = { cols: 8, colW: 40, gap: 10, rowH: 2.2, rows: 1 };

    const tokens = () => {
      const s = getComputedStyle(report);
      return {
        add: s.getPropertyValue("--add").trim(),
        del: s.getPropertyValue("--del").trim(),
        signal: s.getPropertyValue("--signal").trim(),
      };
    };

    const layout = () => {
      const width = canvas.parentElement!.clientWidth - 32;
      const cols = width >= 520 ? 10 : width >= 330 ? 8 : 6;
      const gap = width >= 400 ? 10 : 7;
      const colW = (width - gap * (cols - 1)) / cols;
      const rows = Math.ceil(lines.length / cols);
      const rowH = 2.2;
      geometry = { cols, colW, gap, rowH, rows };
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.style.height = `${rows * rowH}px`;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(rows * rowH * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const draw = () => {
      const { colW, gap, rowH, rows } = geometry;
      const c = tokens();
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      const limit = Math.floor(lines.length * revealed);
      for (let i = 0; i < limit; i++) {
        const l = lines[i];
        if (!l) continue;
        const col = Math.floor(i / rows);
        const row = i % rows;
        const lit = highlight === null || highlight === l.m;
        const indent = l.ind * 0.08;
        const x = col * (colW + gap) + colW * indent;
        const w = Math.max(2, l.len * colW * (1 - indent));
        ctx.globalAlpha = lit ? 1 : 0.14;
        ctx.fillStyle = highlight === "vendor" && lit ? c.signal : l.add ? c.add : c.del;
        ctx.fillRect(x, row * rowH, w, rowH * 0.6);
      }
      ctx.globalAlpha = 1;
    };

    const setHighlight = (m: Meaning | null) => {
      highlight = m;
      draw();
    };

    for (const b of buttons) {
      const m = b.dataset.meaning as Meaning;
      b.addEventListener("pointerenter", () => setHighlight(m));
      b.addEventListener("focus", () => setHighlight(m));
      b.addEventListener("pointerleave", () => setHighlight(pinned));
      b.addEventListener("blur", () => setHighlight(pinned));
      b.addEventListener("click", () => {
        pinned = pinned === m ? null : m;
        for (const other of buttons) other.setAttribute("aria-pressed", String(other.dataset.meaning === pinned));
        setHighlight(pinned ?? m);
      });
    }

    layout();
    const fmt = new Intl.NumberFormat("en-US");

    if (document.documentElement.classList.contains("motion")) {
      revealed = 0;
      const start = performance.now() + 150;
      const duration = 1300;
      const tick = (now: number) => {
        const p = Math.min(1, Math.max(0, (now - start) / duration));
        revealed = 1 - Math.pow(1 - p, 3);
        count.textContent = fmt.format(Math.round(totalChanged * revealed));
        draw();
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    } else {
      draw();
    }

    new ResizeObserver(() => {
      layout();
      draw();
    }).observe(canvas.parentElement!);
    window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", draw);
  }
</script>
