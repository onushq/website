---
import { sources } from "../data/sources";
---

<div class="band on-band ending">
  <section class="section closing wrap" aria-labelledby="closing-title">
    <h2 class="display-l" id="closing-title">
      We don't need people to read more code. We need a system where nobody has to pretend they did.
    </h2>
    <div class="foot">
      <p class="body-l muted">
        Onus comes from <i>onus probandi</i>, the burden of proof. Today it sits on a reviewer reading lines.
        Onus moves it to the agent, which has to show its work.
      </p>
      <a class="o-button o-button--primary" href="https://github.com/onushq">Follow Onus on GitHub</a>
    </div>
  </section>

  <footer class="wrap site-footer" aria-labelledby="sources-title">
    <div class="footer-grid">
      <div>
        <p class="wordmark">Onus</p>
        <p class="caption muted credit">
          Onus puts into practice the Agentic Coding Paradigm, set out by Mikias Abebe in the manifesto{" "}
          <i>Code Is Not the Product</i> (September 2026).
        </p>
      </div>
      <div>
        <h2 class="label muted" id="sources-title">Sources</h2>
        <ol class="sources">
          {
            sources.map((s, i) => (
              <li id={`source-${i + 1}`}>
                <a href={s.url}>{s.title}</a>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
    <p class="caption muted fine">© 2026 Onus</p>
  </footer>
</div>

<style>
  .closing {
    padding-bottom: clamp(var(--space-9), 4rem + 5vw, var(--space-10));
  }

  .closing h2 {
    max-width: 18ch;
  }

  .foot {
    margin-top: clamp(var(--space-7), 2rem + 3vw, var(--space-8));
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .foot .body-l {
    max-width: 34rem;
  }

  .site-footer {
    padding-block: var(--space-7);
    border-top: 1px solid color-mix(in srgb, var(--on-band) 14%, transparent);
  }

  .footer-grid {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 56rem) {
    .footer-grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: var(--space-9);
    }
  }

  .wordmark {
    font-size: 1.5rem;
    font-stretch: 125%;
    font-weight: 750;
    letter-spacing: -0.035em;
  }

  .credit {
    margin-top: var(--space-3);
    max-width: 30rem;
  }

  .sources {
    margin-top: var(--space-3);
    display: grid;
    gap: var(--space-2);
    list-style: decimal;
    padding-left: 1.25rem;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--on-band-muted);
  }

  .sources a {
    color: var(--on-band);
    text-decoration-color: color-mix(in srgb, var(--on-band) 35%, transparent);
  }

  .sources li:target a {
    background: var(--signal);
    color: var(--on-signal);
  }

  .fine {
    margin-top: var(--space-7);
  }
</style>
