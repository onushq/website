---
interface Chip {
  t: string;
  signal?: boolean;
  blocked?: boolean;
}
const lanes: { name: string; who: string; chips: Chip[] }[] = [
  { name: "Auto-merge", who: "Evidence checks alone", chips: [{ t: "Internal refactor" }, { t: "New tests" }] },
  { name: "Judge", who: "The verifying judge", chips: [{ t: "Additive contract change" }, { t: "New internal dependency" }] },
  { name: "Human", who: "A person reads the report", chips: [{ t: "New SMS vendor receives phone numbers", signal: true }] },
  { name: "Blocked", who: "Nobody, until it's fixed", chips: [{ t: "Write outside scope", blocked: true }, { t: "Tests weakened", blocked: true }] },
];
---

<div class="lanes-vis">
  {
    lanes.map((l) => (
      <div class="o-lane">
        <p class="o-lane__name">{l.name}</p>
        <p class="o-lane__who">{l.who}</p>
        {l.chips.map((c) => (
          <span class:list={["o-chip", c.signal && "o-chip--signal", c.blocked && "o-chip--blocked"]}>{c.t}</span>
        ))}
      </div>
    ))
  }
</div>

<style>
  .lanes-vis {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    align-content: center;
    height: 100%;
  }
</style>
