---
const checks = [
  { name: "Re-ran the evidence in a fresh environment", note: "Tests run from scratch; the author's results were not reused" },
  { name: "Intent matches effect", note: "Four changes in meaning, all named in the stated intent" },
  { name: "Contracts and rules hold", note: "UserPreferences change is additive; no boundary crossed" },
  { name: "No tests were weakened", note: "No deleted assertions, skips or special-cased inputs" },
  { name: "Held-out checks passed", note: "Opt-out and verification combined, which the author never saw" },
  { name: "Taste", note: "Naming and structure fit the codebase. Counts, but less.", soft: true },
];
---

<div class="judge-vis o-window">
  <div class="o-window__bar">
    <p class="o-window__title">Judge</p>
    <span class="o-pill o-pill--outline">Routed to a person</span>
  </div>
  <ul class="list">
    {
      checks.map((c) => (
        <li class:list={["o-check", c.soft && "o-check--soft"]}>
          <span class="o-check__mark" aria-hidden="true">
            <svg viewBox="0 0 12 12" fill="none">
              <path d="M2.5 6.2 5 8.6l4.5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <span>
            <span class="o-check__name">{c.name}</span>
            <span class="o-check__note">{c.note}</span>
          </span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .judge-vis {
    align-self: center;
  }

  .list {
    padding: 0 var(--space-5) var(--space-2);
  }

  .list li:first-child {
    border-top: 0;
  }

  .o-check__name,
  .o-check__note {
    display: block;
  }
</style>
