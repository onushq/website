---
// The codebase map for the example feature, answering one question.
const nodes = [
  { id: "orders", label: "orders", x: 16, y: 24 },
  { id: "prefs", label: "user-preferences", x: 56, y: 24, answer: true },
  { id: "notifications", label: "notifications", x: 28, y: 62 },
  { id: "billing", label: "billing", x: 80, y: 62 },
  { id: "sms", label: "SMS provider", x: 44, y: 92, external: true },
];
const edges: { from: string; to: string; label?: string; lit?: boolean; signal?: boolean }[] = [
  { from: "orders", to: "notifications", label: "OrderShipped" },
  { from: "notifications", to: "prefs", lit: true },
  { from: "billing", to: "prefs", lit: true },
  { from: "notifications", to: "sms", label: "new", signal: true },
];
const at = (id: string) => nodes.find((n) => n.id === id)!;
---

<div class="map-vis">
  <div class="query">
    <span class="q">What depends on UserPreferences?</span>
    <span class="a">notifications, billing</span>
  </div>
  <div class="graph">
    <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      {
        edges.map((e) => {
          const a = at(e.from);
          const b = at(e.to);
          return (
            <line
              x1={a.x}
              y1={a.y}
              x2={b.x}
              y2={b.y}
              class:list={["edge", e.lit && "edge-lit", e.signal && "edge-signal"]}
              vector-effect="non-scaling-stroke"
            />
          );
        })
      }
    </svg>
    {
      edges.filter((e) => e.label).map((e) => {
        const a = at(e.from);
        const b = at(e.to);
        return (
          <span class:list={["edge-label", e.signal && "edge-label-signal"]} style={`left:${(a.x + b.x) / 2}%;top:${(a.y + b.y) / 2}%`}>
            {e.label}
          </span>
        );
      })
    }
    {
      nodes.map((n) => (
        <span
          class:list={["node", n.answer && "node-answer", n.external && "node-external"]}
          style={`left:${n.x}%;top:${n.y}%`}
        >
          {n.label}
        </span>
      ))
    }
  </div>
</div>

<style>
  .map-vis {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: var(--space-4);
    height: 100%;
  }

  .query {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: 0.875rem;
  }

  .q,
  .a {
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-pill);
  }

  .q {
    background: var(--ink);
    color: var(--canvas);
    font-weight: 600;
  }

  .a {
    background: var(--surface);
    color: var(--ink);
  }

  .graph {
    position: relative;
    min-height: 260px;
    container-type: inline-size;
  }

  svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .edge {
    stroke: var(--ink-faint);
    stroke-width: 1.5;
  }

  .edge-lit {
    stroke: var(--ink);
    stroke-width: 2;
  }

  .edge-signal {
    stroke: var(--signal);
    stroke-width: 2;
    stroke-dasharray: 5 4;
  }

  .edge-label {
    position: absolute;
    transform: translate(-50%, -50%);
    padding: 1px var(--space-2);
    border-radius: var(--radius-xs);
    background: var(--surface);
    font-size: 0.75rem;
    font-stretch: 85%;
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .edge-label-signal {
    background: var(--signal);
    color: var(--on-signal);
    font-weight: 600;
  }

  .node {
    position: absolute;
    transform: translate(-50%, -50%);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-s);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line), var(--shadow-pop);
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .node-answer {
    box-shadow: inset 0 0 0 2px var(--ink), var(--shadow-pop);
  }

  /* Narrow stages: smaller nodes, and only the label that matters stays. */
  @container (max-width: 26rem) {
    .node {
      font-size: 0.75rem;
      padding: 6px var(--space-2);
    }

    .edge-label:not(.edge-label-signal) {
      display: none;
    }
  }

  .node-external {
    background: transparent;
    box-shadow: none;
    outline: 1.5px dashed var(--signal);
    outline-offset: -1.5px;
  }
</style>
