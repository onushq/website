---
const scopes = [
  { k: "Write", v: "notifications internals" },
  { k: "Read", v: "OrderShipped, UserPreferences" },
  { k: "Network", v: "SMS provider test endpoint" },
  { k: "Expires", v: "When the task ends" },
];
---

<div class="token-vis">
  <div class="o-keycard">
    <div class="o-keycard__stripe"></div>
    <div class="o-keycard__body">
      <p class="o-keycard__task">Token for “Text customers when their order ships”</p>
      <dl class="o-keycard__scopes">
        {
          scopes.map((s) => (
            <div class="o-keycard__scope">
              <dt>{s.k}</dt>
              <dd>{s.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
  <div class="escalation">
    <p class="label muted">Escalation</p>
    <p class="ask">Add an optional phoneVerified field to UserPreferences</p>
    <ul>
      <li><span class="tick" aria-hidden="true"></span>Failing test: texts an unverified number</li>
      <li><span class="tick" aria-hidden="true"></span>Map path: notifications reads UserPreferences</li>
    </ul>
    <span class="o-pill">Granted by the judge: additive</span>
  </div>
</div>

<style>
  .token-vis {
    display: grid;
    gap: var(--space-4);
    align-content: center;
    height: 100%;
  }

  .escalation {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-m);
    background: var(--sunken);
  }

  .ask {
    font-weight: 620;
    line-height: 1.35;
  }

  ul {
    display: grid;
    gap: var(--space-1);
    font-size: 0.875rem;
    color: var(--ink-muted);
    margin-bottom: var(--space-2);
  }

  li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .tick {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--add);
    flex: none;
  }
</style>
