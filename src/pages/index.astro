---
// The story page is static; only /docs renders on demand.
export const prerender = true;

import Base from "../layouts/Base.astro";
import SceneLayer from "../components/SceneLayer.astro";
import Header from "../components/Header.astro";
import ChapterRail from "../components/ChapterRail.astro";
import Hero from "../components/chapters/Hero.astro";
import Problem from "../components/chapters/Problem.astro";
import Meaning from "../components/chapters/Meaning.astro";
import Examples from "../components/chapters/Examples.astro";
import MapChapter from "../components/chapters/MapChapter.astro";
import Proof from "../components/chapters/Proof.astro";
import Lanes from "../components/chapters/Lanes.astro";
import Judge from "../components/chapters/Judge.astro";
import TrackRecords from "../components/chapters/TrackRecords.astro";
import Agents from "../components/chapters/Agents.astro";
import Dashboard from "../components/chapters/Dashboard.astro";
import Benchmarks from "../components/chapters/Benchmarks.astro";
import Install from "../components/chapters/Install.astro";
import Closing from "../components/chapters/Closing.astro";
import Footer from "../components/Footer.astro";
---

<Base
  title="Onus | Code is not the product"
  description="Onus is the layer every coding agent works through. It reads each change for what it means, routes it by risk, and approves it on evidence instead of line-by-line review."
>
  <SceneLayer />
  <Header />
  <ChapterRail />
  <main id="main">
    <Hero />
    <Problem />
    <Meaning />
    <Examples />
    <MapChapter />
    <Proof />
    <Lanes />
    <Judge />
    <TrackRecords />
    <Agents />
    <Dashboard />
    <Benchmarks />
    <Install />
    <Closing />
  </main>
  <Footer />
</Base>
