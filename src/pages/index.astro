---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Problem from "../components/Problem.astro";
import Thesis from "../components/Thesis.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Attention from "../components/Attention.astro";
import Agents from "../components/Agents.astro";
import Roadmap from "../components/Roadmap.astro";
import Closing from "../components/Closing.astro";
---

<Base
  title="Onus | Code is not the product"
  description="Onus is the layer every coding agent works through. It reads each change for what it means, routes it by risk, and approves it on evidence instead of line-by-line review."
>
  <Header />
  <main id="main">
    <Hero />
    <Problem />
    <Thesis />
    <HowItWorks />
    <Attention />
    <Agents />
    <Roadmap />
  </main>
  <Closing />
</Base>
