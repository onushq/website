---
// Prerendered (in Node, astro.config.mjs): rendering a docs page highlights its code with
// WebAssembly, which a Cloudflare Worker may not compile. Search, Markdown, llms.txt and
// MCP stay on demand in the Worker (middleware.ts, api/docs.ts).
export const prerender = true;

import DocsShell from "../../components/DocsShell.astro";
import { load } from "../../lib/docs.server";

let data;
try {
  data = await load(`${Astro.url.pathname}${Astro.url.search}`);
} catch (error) {
  if ((error as { status?: number }).status === 404) {
    return new Response("Not found", { status: 404, headers: { "Content-Type": "text/plain" } });
  }
  throw error;
}
---

<DocsShell data={data} />
